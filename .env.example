# Copy to .env and fill in. Mock mode is used automatically when empty.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# Thresholds (tune these, not the prompts)
BLOCK_AT_SEVERITY=2
REVIEW_AT_SEVERITY=1
BLOCK_AT_NOUL=0.85
REVIEW_AT_NOUL=0.55
# Email triage policy (src/emailPolicy.ts)
EMAIL_ESCALATE_AT_URGENCY=4
EMAIL_REVIEW_BELOW_CONFIDENCE=0.6
EMAIL_REVIEW_MARGIN=0.15
